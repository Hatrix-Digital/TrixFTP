{
  "name": "trixftp",
  "productName": "TrixFTP",
  "version": "1.1.1",
  "description": "TrixFTP - fast, modern dual-pane FTP/FTPS/SFTP client",
  "main": "main.js",
  "author": "TrixFTP Team <trixftp@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test:engine": "node test/engine.test.js",
    "test:queue": "node test/queue.test.js",
    "test:updater": "node test/updater.test.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.18.0",
    "ftp-srv": "^4.6.3"
  },
  "build": {
    "appId": "com.trixftp.app",
    "productName": "TrixFTP",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.file-transfer",
      "icon": "build/icon.icns"
    }
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "electron@37.10.3": true
  }
}
